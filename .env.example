# 1 (défaut) = données simulées, le front avance sans Django. 0 = vrai back.
NEXT_PUBLIC_MOCKS=1
# URL de Django (relayée par Next sur /api/* et /media/*)
BACKEND_URL=http://localhost:8000
# Fond de carte : openfreemap (défaut) | osm (raster, plan B) | URL d'un style MapLibre
NEXT_PUBLIC_MAP_STYLE=openfreemap
# Précision GPS max acceptée, en mètres (même valeur que GPS_MAX_ACCURACY_M côté Django)
NEXT_PUBLIC_PRECISION_MAX_M=50
# 1 = ignorer le contrôle "dans Cotonou" (tests hors zone uniquement)
NEXT_PUBLIC_IGNORER_ZONE=0
# En mode simulé, force un refus pour tester l'écran : un code du contrat (PHOTO_MISMATCH, PHOTO_SCREENSHOT, TOO_FAR…)
NEXT_PUBLIC_MOCK_REFUS=
