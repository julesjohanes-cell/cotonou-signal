{
  "name": "cotonou-signale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:agents": "node scripts/check-agents.mjs",
    "verify": "pnpm check:agents && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "api:generate": "swagger-typescript-api generate -p contrat/openapi.yaml -o lib/generated -n api-django.ts --no-client --enum-style=union --extract-request-body",
    "api:sync": "B=\"${BACK_DIR:-../cotonou-signal-back}\"; cp \"$B/docs/openapi.yaml\" \"$B/docs/api-contract.md\" contrat/ && pnpm api:generate",
    "api:check": "pnpm api:generate && git diff --exit-code -- lib/generated",
    "demo:cd": "bash scripts/demo-continue.sh",
    "postinstall": "node -e \"require('fs').copyFileSync('node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs','public/maplibre-gl-worker.js')\""
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@tanstack/react-query": "^5.104.3",
    "antd": "^6.6.6",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "maplibre-gl": "^6.14.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "jsdom": "^30.1.3",
    "swagger-typescript-api": "^13.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
